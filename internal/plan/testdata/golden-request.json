{
  "reference": "golden-contract-test",
  "resources": [
    {
      "factTable": {
        "name": "factTables/warehouse-events",
        "sql": "SELECT user_id, event_time, amount FROM warehouse.events",
        "displayName": "Warehouse Events",
        "timestampColumn": {
          "name": "event_time"
        },
        "entities": [
          {
            "column": {
              "name": "user_id"
            },
            "entity": "entities/user1"
          }
        ],
        "measures": [
          {
            "column": {
              "name": "amount"
            },
            "displayName": "amount"
          }
        ],
        "dimensions": [
          {
            "name": "region"
          }
        ]
      }
    },
    {
      "factTable": {
        "name": "factTables/revenue-events",
        "sql": "SELECT user_id, event_time, revenue_usd, page_views\nFROM analytics.prod.revenue\nWHERE event_time BETWEEN TIMESTAMP({START_TIME}) AND TIMESTAMP({END_TIME})",
        "displayName": "Revenue Events",
        "timestampColumn": {
          "name": "event_time"
        },
        "entities": [
          {
            "column": {
              "name": "user_id"
            },
            "entity": "entities/user1"
          }
        ],
        "measures": [
          {
            "column": {
              "name": "revenue_usd"
            },
            "displayName": "revenue",
            "unit": {
              "currencyCode": "USD"
            }
          },
          {
            "column": {
              "name": "page_views"
            },
            "displayName": "page_views",
            "unit": {
              "customUnit": "view"
            }
          }
        ],
        "owner": "identities/revenue-team",
        "labels": {
          "domain": "monetization",
          "team": "growth"
        }
      }
    },
    {
      "factTable": {
