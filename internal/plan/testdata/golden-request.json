            },
            "entity": "entities/user1"
          }
        ],
        "measures": [
          {
            "column": {
              "name": "value"
            },
            "displayName": "value"
          }
        ]
      }
    },
    {
      "factTable": {
        "name": "factTables/checkout-events",
        "sql": "SELECT user_id, event_time, started, completed, platform\nFROM analytics.prod.checkout_events\nWHERE event_time BETWEEN {START_TIME} AND {END_TIME}\n",
        "displayName": "Checkout Events",
        "timestampColumn": {
          "name": "event_time"
        },
        "entities": [
          {
            "column": {
              "name": "user_id"
            },
            "entity": "entities/user1"
          }
        ],
        "measures": [
          {
            "column": {
              "name": "started"
            },
            "displayName": "checkouts_started"
          },
          {
            "column": {
              "name": "completed"
            },
            "displayName": "checkouts_completed"
          }
        ],
        "dimensions": [
          {
            "name": "platform"
          }
        ]
      }
    },
    {
      "factTable": {
        "name": "factTables/hourly-stream",
        "sql": "SELECT user_id, event_time, (ms_played / 60000) AS minutes_played, (stream_count \u003e 0) AS had_stream, platform, content_type FROM analytics.prod.hourly_stream",
        "displayName": "Hourly Stream",
        "description": "Hourly streaming aggregates per user.",
        "timestampColumn": {
          "name": "event_time"
        },
        "entities": [
          {
            "column": {
              "name": "user_id"
            },
            "entity": "entities/user1"
          }
        ],
        "measures": [
          {
            "column": {
              "name": "minutes_played"
            },
            "displayName": "minutes_played"
          },
          {
            "column": {
              "name": "had_stream"
            },
            "displayName": "had_stream"
          }
        ],
        "dimensions": [
          {
            "name": "platform"
          },
          {
            "name": "content_type"
          }
        ]
      }
    },
    {
      "factTable": {
        "name": "factTables/simple-events",
        "sql": "SELECT user_id, ts, value FROM events",
        "displayName": "Simple Events",
        "timestampColumn": {
          "name": "ts"
        },
        "entities": [
          {
            "column": {
              "name": "user_id"
            },
            "entity": "entities/user1"
          }
        ],
        "measures": [
          {
            "column": {
              "name": "value"
            }
          }
        ]
      }
    },
    {
      "measurement": {
        "name": "measurements/capped-revenue",
        "displayName": "Capped Revenue",
        "entity": "entities/user1",
        "factTable": "factTables/revenue-events",
        "typeSpec": {
          "averageMetricSpec": {
            "measurement": {
              "name": "revenue_usd"
            },
            "aggregation": {
              "type": "AGGREGATION_TYPE_SUM",
              "cap": {
                "max": {
                  "value": "1000"
                }
              }
            }
          }
        }
      }
    },
    {
      "measurement": {
        "name": "measurements/capped-conversion",
        "displayName": "Capped Conversion",
        "entity": "entities/user1",
        "factTable": "factTables/checkout-events",
        "typeSpec": {
          "ratioMetricSpec": {
            "numerator": {
              "name": "completed"
            },
            "numeratorAggregation": {
              "type": "AGGREGATION_TYPE_SUM",
              "cap": {
                "min": {
                  "value": "0"
                }
              }
            },
            "denominator": {
              "name": "started"
            },
            "denominatorAggregation": {
              "type": "AGGREGATION_TYPE_SUM",
              "cap": {
                "max": {
                  "value": "100"
                }
              }
            }
          }
        }
      }
    },
    {
      "measurement": {
        "name": "measurements/high-value-streams",
        "displayName": "High Value Streams",
        "entity": "entities/user1",
        "factTable": "factTables/hourly-stream",
        "typeSpec": {
          "averageMetricSpec": {
            "measurement": {
              "name": "minutes_played"
            },
            "aggregation": {
              "type": "AGGREGATION_TYPE_SUM"
            }
          }
        },
        "filter": {
          "criteria": {
            "c0": {
              "attribute": {
                "attribute": "content_type",
                "eqRule": {
                  "value": {
                    "stringValue": "music"
                  }
                }
              }
            },
            "c1": {
              "attribute": {
                "attribute": "platform",
                "likeRule": {
                  "pattern": "ios%"
                }
              }
            }
          },
          "expression": {
            "and": {
              "operands": [
                {
                  "ref": "c0"
                },
                {
                  "ref": "c1"
                }
              ]
            }
          }
        }
      }
    },
    {
      "measurement": {
        "name": "measurements/median-minutes-played",
        "displayName": "Median Minutes Played",
        "entity": "entities/user1",
        "factTable": "factTables/hourly-stream",
        "typeSpec": {
          "quantileMetricSpec": {
            "measurement": {
              "name": "minutes_played"
            },
            "aggregation": {
              "type": "AGGREGATION_TYPE_SUM"
            },
            "quantileLevel": 0.5
          }
        }
      }
    },
